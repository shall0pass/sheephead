{
	"name": "clabber",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "npm --prefix sync-server start",
		"sync:dev": "npm --prefix sync-server run dev",
		"sync:install": "npm --prefix sync-server install",
		"pages:dev": "npm run build && wrangler pages dev build --kv GAMES",
		"pages:deploy": "npm run build && wrangler pages deploy build",
		"prepare": "svelte-kit sync || echo ''",
		"icons": "node scripts/gen-icons.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/canvas-confetti": "1.9.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vite-plugin-wasm": "3.6.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "4.127.0"
	},
	"dependencies": {
		"@automerge/automerge": "3.4.1",
		"@automerge/automerge-repo": "2.5.6",
		"@automerge/automerge-repo-network-websocket": "2.5.6",
		"@automerge/automerge-repo-storage-indexeddb": "2.5.6",
		"canvas-confetti": "1.9.4"
	}
}
