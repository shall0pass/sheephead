# Committed production defaults, loaded by `vite build`.
#
# `$env/static/public` fails the build if PUBLIC_SYNC_URL is missing, so this
# guarantees a working value on hosts (e.g. Cloudflare Pages) where the repo's
# .env is absent. A build-time environment variable of the same name — set in
# the Cloudflare dashboard as a *plaintext* variable, not a Secret — overrides
# this. Point it at your own relay to stop using the public one.
PUBLIC_SYNC_URL=wss://sync.automerge.org
